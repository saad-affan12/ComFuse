# ComFuse Backend Environment Configuration
# Add allowed frontend origins, separated by commas (no spaces)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Maximum allowable image upload size in megabytes
MAX_UPLOAD_SIZE_MB=10

# Optional: URL to download checkpoint if deploying without Git LFS
# MODEL_CHECKPOINT_URL=https://your-storage-bucket.com/best_multimodal_model.pt
